    /// @dev 41 gamma_abc_g1 pairs encoded as 41 × 64 bytes (x ++ y, each 32-byte big-endian uint256).
    ///      Stored as a bytes constant so that access is via codecopy, avoiding the large number of
    ///      stack-allocated integer literals that would be created by an if-chain of 41 branches.
    // solhint-disable-next-line max-line-length
    bytes internal constant GAMMA_ABC_DATA =
        hex"";

    /// @dev Static portions of the 8-pair ecPairing input used in WRAPSVerifier.verify().
    ///      Stored as a bytes constant to move 22 VK constants out of the verify() stack frame,
    ///      working around the --ir-minimum / coverage-instrumentation stack-too-deep limit.
    ///
    ///      Layout (704 bytes):
    ///        [0..192)   Pair 2 entirely: alpha_g1 (64 B) ++ beta_g2 (128 B)
    ///        [192..320) Pair 3 G2:  gamma_g2    (128 B)
    ///        [320..448) Pair 4 G2:  delta_g2    (128 B)
    ///        [448..576) Pair 5/7 G2: kzg_h      (128 B)
    ///        [576..704) Pair 6/8 G2: kzg_beta_h (128 B)
    // solhint-disable-next-line max-line-length
    bytes internal constant VK_PAIRING_STATIC =
        hex"";

    /// @notice Returns gamma_abc_g1[i] = (x, y).
    /// @dev Uses a bytes constant lookup to avoid an if-chain of 41 branches, which would
    ///      create too many Yul variables under --ir-minimum / coverage instrumentation.
    function gammaAbc(uint256 i) internal pure returns (uint256 x, uint256 y) {
        if (i > 40) revert WRAPSGammaAbcIndexOutOfRange();
        bytes memory data = GAMMA_ABC_DATA;
        uint256 offset = i * 64;
        assembly ("memory-safe") {
            x := mload(add(add(data, 0x20), offset))
            y := mload(add(add(data, 0x20), add(offset, 0x20)))
        }
    }
}
